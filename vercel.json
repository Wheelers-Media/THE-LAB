{
  "buildCommand": "node tools/build_parts.mjs && node tools/build_reviews.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.thelabfsj.ca" }],
      "destination": "https://thelabfsj.ca/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/src/assets/$1"
    },
    {
      "source": "/styles/(.*)",
      "destination": "/src/styles/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/src/pages/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
